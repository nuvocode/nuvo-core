{
  "name": "nuvo-code-monorepo",
  "private": true,
  "scripts": {
    "dev:core": "pnpm --filter @nuvo-code/core dev",
    "dev:website": "pnpm --filter website dev",
    "build:core": "pnpm --filter @nuvo-code/core build:lib",
    "build:website": "pnpm --filter website build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "semantic-release": "^21.0.0",
    "@semantic-release/commit-analyzer": "^10.0.0",
    "@semantic-release/release-notes-generator": "^11.0.0",
    "@semantic-release/npm": "^10.0.0",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/exec": "^6.0.3",
    "conventional-changelog-conventionalcommits": "^6.1.0"
  }
}
